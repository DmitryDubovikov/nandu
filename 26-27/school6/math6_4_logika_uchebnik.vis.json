{
  "Поэтому проверку парой делай на том числе": "<figure><svg viewBox='0 0 400 275' width='400' height='275' font-family='inherit' font-size='15'><line x1='190.0' y1='30' x2='190.0' y2='236' stroke='#f0a83c' stroke-width='1.6' stroke-dasharray='5 4'/><line x1='286.0' y1='30' x2='286.0' y2='236' stroke='var(--muted)' stroke-width='1.2' stroke-dasharray='3 4'/><text x='286.0' y='22' text-anchor='middle' fill='var(--muted)' font-size='15' font-weight='700'>8</text><text x='20' y='40' text-anchor='start' fill='#4fd1d9' font-size='15' font-weight='600' stroke='var(--bg2)' stroke-width='5' paint-order='stroke'>больше 5</text><line x1='18' y1='62' x2='362' y2='62' stroke='var(--muted)' stroke-width='1.8'/><path d='M356.0,56.0 L364.0,62.0 L356.0,68.0' fill='none' stroke='var(--muted)' stroke-width='1.8' stroke-linejoin='round'/><line x1='30.0' y1='56' x2='30.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='62.0' y1='56' x2='62.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='94.0' y1='56' x2='94.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='126.0' y1='56' x2='126.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='158.0' y1='56' x2='158.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='190.0' y1='56' x2='190.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='222.0' y1='56' x2='222.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='254.0' y1='56' x2='254.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='286.0' y1='56' x2='286.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='318.0' y1='56' x2='318.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><line x1='350.0' y1='56' x2='350.0' y2='68' stroke='var(--muted)' stroke-width='1.4'/><text x='30.0' y='86' text-anchor='middle' fill='var(--muted)' font-size='14'>0</text><text x='62.0' y='86' text-anchor='middle' fill='var(--muted)' font-size='14'>1</text><text x='94.0' y='86' text-anchor='middle' fill='var(--mu