t x=\"320\" y=\"306\" fill=\"#93a1b1\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\">→</text><rect x=\"342\" y=\"34\" width=\"92\" height=\"191.176\" rx=\"0\" fill=\"#d9e2ec\" fill-opacity=\".28\" stroke=\"#d9e2ec\"/><text x=\"388\" y=\"134.588\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">780</text><rect x=\"342\" y=\"225.176\" width=\"92\" height=\"22.0588\" rx=\"0\" fill=\"#f2686c\" fill-opacity=\".4\" stroke=\"#f2686c\"/><text x=\"388\" y=\"241.206\" fill=\"#ffd9da\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">90</text><rect x=\"342\" y=\"247.235\" width=\"92\" height=\"36.7647\" rx=\"0\" fill=\"#5ba8f5\" fill-opacity=\".4\" stroke=\"#5ba8f5\"/><text x=\"388\" y=\"270.618\" fill=\"#dceaff\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">150</text><text x=\"388\" y=\"306\" fill=\"#93a1b1\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\">раунд 2</text><text x=\"456\" y=\"306\" fill=\"#93a1b1\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\">→</text><rect x=\"478\" y=\"34\" width=\"92\" height=\"202.941\" rx=\"0\" fill=\"#d9e2ec\" fill-opacity=\".28\" stroke=\"#d9e2ec\"/><text x=\"524\" y=\"140.471\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">828</text><rect x=\"478\" y=\"236.941\" width=\"92\" height=\"17.6471\" rx=\"0\" fill=\"#f2686c\" fill-opacity=\".4\" stroke=\"#f2686c\"/><text x=\"524\" y=\"250.765\" fill=\"#ffd9da\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">72</text><rect x=\"478\" y=\"254.588\" width=\"92\" height=\"29.4118\" rx=\"0\" fill=\"#5ba8f5\" fill-opacity=\".4\" stroke=\"#5ba8f5\"/><text x=\"524\" y=\"274.294\" fill=\"#dceaff\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">120</text><text x=\"524\" y=\"306\" fill=\"#93a1b1\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\">раунд 3</text><line x1=\"62\" y1=\"34\" x2=\"578\" y2=\"34\" stroke=\"#f0a83c\" stroke-width=\"2\" str