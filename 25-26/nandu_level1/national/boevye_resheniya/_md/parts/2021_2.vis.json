\" y1=\"38.0\" x2=\"165.0\" y2=\"290.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-dasharray=\"6 6\"/><line x1=\"543.0\" y1=\"290.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--muted)\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><line x1=\"165.0\" y1=\"38.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--gold)\" stroke-width=\"4.5\" stroke-linecap=\"round\"/><g class=\"sl\" style=\"--to:translate(0,252.0px);--d:.6s\"><line x1=\"165.0\" y1=\"38.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--gold)\" stroke-width=\"5.5\" stroke-linecap=\"round\"/></g><circle cx=\"165.0\" cy=\"290.0\" r=\"4.5\" fill=\"var(--gold)\"/><text x=\"165.0\" y=\"316.0\" fill=\"var(--gold)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">M</text><circle cx=\"60.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"48.0\" y=\"526.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">A</text><circle cx=\"270.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"270.0\" y=\"528.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">B</text><circle cx=\"543.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"555.0\" y=\"526.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">C</text><circle cx=\"60.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"42.0\" y=\"296.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">G</text><circle cx=\"270.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"284.0\" y=\"280.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">H</text><circle cx=\"543.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"557.0\" y=\"280.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">I</text><circle cx=\"543.0\" cy=\"38.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"557.0\" y=\"28.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">E</text><circle cx=\"165.0\" cy=\"38.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"165.0\" y=\"24.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">F</text><circle cx=\"643.7\" cy=\"269.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"659.7\" y=\"273.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">D</text><text x=\"112.5\" y=\"280.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">s : 2</text><text x=\"217.5\" y=\"280.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">s : 2</text><text x=\"406.5\" y=\"318.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"96.5\" y=\"164.0\" fill=\"var(--blue)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"233.5\" y=\"164.0\" fill=\"var(--blue)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"354.0\" y=\"26.0\" fill=\"var(--gold)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">FE = s : 2 + t</text></svg><figcaption>Синие стороны крыши равны, поэтому F стоит ровно над серединой M отрезка GH. FM и EI — вертикали, FE параллельна GI, так что FMIE — прямоугольник: золотой потолок FE опускается и ложится точно на пол MI — половину стороны квадрата и ещё HI.</figcaption></figure>",
