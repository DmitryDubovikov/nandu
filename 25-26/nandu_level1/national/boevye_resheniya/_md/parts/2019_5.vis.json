9.5'/><line x1='434' y1='514' x2='335' y2='659.5'/><line x1='242' y1='50' x2='242' y2='226'/><line x1='434' y1='306' x2='50' y2='306'/><line x1='50' y1='514' x2='434' y2='514'/></g><g fill='#93a1b1' font-size='24' text-anchor='middle' font-weight='600'><text x='26' y='314'>E</text><text x='458' y='314'>C</text><text x='30' y='540'>A</text><text x='456' y='540'>B</text><text x='242' y='34'>D</text><text x='222' y='218'>F</text><text x='335' y='694'>O</text></g><path class='dr' pathLength='100' style='--d:0.2s;--dur:2s' stroke='#f0a83c' stroke-width='7' fill='none' stroke-linejoin='round' stroke-linecap='round' d='M434 306L242 50L50 306Z'/><text x='366' y='168' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:0.9s'>b</text><text x='118' y='168' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.4s'>b</text><text x='242' y='334' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.9s'>d</text></svg><p class='ccap'><b>(3)</b> P(CDE) = 128</p></div><div class='cell'><svg viewBox='0 10 490 700' role='img' aria-label='Треугольник DEF'><g stroke='#4a5866' stroke-width='3' stroke-linecap='round'><line x1='50' y1='514' x2='50' y2='306'/><line x1='434' y1='514' x2='434' y2='306'/><line x1='434' y1='306' x2='242' y2='226'/><line x1='242' y1='226' x2='50' y2='306'/><line x1='434' y1='306' x2='242' y2='50'/><line x1='242' y1='50' x2='50' y2='306'/><line x1='50' y1='514' x2='335' y2='659.5'/><line x1='434' y1='514' x2='335' y2='659.5'/><line x1='242' y1='50' x2='242' y2='226'/><line x1='434' y1='306' x2='50' y2='306'/><line x1='50' y1='514' x2='434' y2='514'/></g><g fill='#93a1b1' font-size='24' text-anchor='middle' font-weight='600'><text x='26' y='314'>E</text><text x='458' y='314'>C</text><text x='30' y='540'>A</text><text x='456' y='540'>B</text><text x='242' y='34'>D</text><text x='222' y='218'>F</text><text x='335' y='694'>O</text></g><path class='dr' pathLength='100' style='--d:0.2s;--dur:2s' stroke='#f0a83c' stroke-width='7' fill='none' stroke-linejoin='round' stroke-linecap='round' d='M242 50L50 306L242 226Z'/><text x='118' y='168' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:0.9s'>b</text><text x='136' y='248' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.4s'>a</text><text x='264' y='150' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.9s'>c</text></svg><p class='ccap'><b>(4)</b> P(DEF) = 88</p></div></div><figcaption>Четыре данных контура — четыре уравнения. Сравни подписи в (1) и (4): у контура AOBCE есть b, c и a — те же три буквы, что обходят треугольник DEF, хотя сам треугольник стоит совсем в другом месте рисунка.</figcaption></figure>",
 "Контур AOBCFE: AO, OB, BC, CF, FE, EA.": "<figure class='st fx'><div class='fgrid2'><div class='cell'><svg viewBox='0 10 490 700' role='img' aria-label='Периметр ABCFE'><g stroke='#4a5866' stroke-width='3' stroke-linecap='round'><line x1='50' y1='514' x2='50' y2='306'/><line x1='434' y1='514' x2='434' y2='306'/><line x1='434' y1='306' x2='242' y2='226'/><line x1='242' y1='226' x2='50' y2='306'/><line x1='434' y1='306' x2='242' y2='50'/><line x1='242' y1='50' x2='50' y2='306'/><line x1='50' y1='514' x2='335' y2='659.5'/><line x1='434' y1='514' x2='335' y2='659.5'/><line x1='242' y1='50' x2='242' y2='226'/><line x1='434' y1='306' x2='50' y2='306'/><line x1='50' y1='514' x2='434' y2='514'/></g><g fill='#93a1b1' font-size='24' text-anchor='middle' font-weight='600'><text x='26' y='314'>E</text><text x='458' y='314'>C</text><text x='30' y='540'>A</text><text x='456' y='540'>B</text><text x='242' y='34'>D</text><text x='222' y='218'>F</text><text x='335' y='694'>O</text></g><path class='dr' pathLength='100' style='--d:0.2s;--dur:2s' stroke='#f0a83c' stroke-width='7' fill='none' stroke-linejoin='round' stroke-linecap='round' d='M50 514L434 514L434 306L242 226L50 306Z'/><text x='242' y='560' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:0.9s'>d</text><text x='462' y='420' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.4s'>a</text><text x='348' y='248' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:1.9s'>a</text><text x='136' y='248' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:2.4s'>a</text><text x='24' y='420' fill='#f0a83c' font-size='34' font-style='italic' text-anchor='middle' font-weight='600' class='fi' style='--d:2.9s'>a</text></svg><p class='ccap'><b>P(ABCFE)</b> = d + a + a + a + a</p></div><div class='cell