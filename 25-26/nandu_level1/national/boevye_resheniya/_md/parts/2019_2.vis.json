 y1=\"30.0\" x2=\"394.0\" y2=\"30.0\" stroke=\"#f2686c\" stroke-width=\"3.2\" stroke-linecap=\"round\"/><line x1=\"366.0\" y1=\"282.0\" x2=\"394.0\" y2=\"282.0\" stroke=\"#f2686c\" stroke-width=\"3.2\" stroke-linecap=\"round\"/><text x=\"18\" y=\"48\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">k</text><text x=\"14\" y=\"102\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">2k</text><text x=\"14\" y=\"210\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">4k</text><text x=\"294\" y=\"48\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">k</text><text x=\"298\" y=\"102\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">2k</text><text x=\"298\" y=\"210\" fill=\"#f0a83c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">4k</text><text x=\"156\" y=\"18\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"156\" y=\"55\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"156\" y=\"127\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"156\" y=\"296\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"355\" y=\"156\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"406\" y=\"156\" fill=\"#5ba8f5\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">a</text><text x=\"324\" y=\"18\" fill=\"#5fd38d\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">b</text><text x=\"324\" y=\"296\" fill=\"#5fd38d\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">b</text><text x=\"380\" y=\"18\" fill=\"#f2686c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">c</text><text x=\"380\" y=\"296\" fill=\"#f2686c\" font-size=\"15\" font-style=\"italic\" font-weight=\"700\" text-anchor=\"middle\" dominant-baseline=\"middle\">c</text><circle cx=\"30.0\" cy=\"30.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"282.0\" cy=\"30.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"366.0\" cy=\"30.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"394.0\" cy=\"30.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"30.0\" cy=\"66.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"30.0\" cy=\"138.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"282.0\" cy=\"66.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"282.0\" cy=\"138.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"30.0\" cy=\"282.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"282.0\" cy=\"282.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"366.0\" cy=\"282.0\" r=\"3\" fill=\"#e8eef6\"/><circle cx=\"394.0\" cy=\"282.0\" r=\"3\" fill=\"#e8eef6\"/><text x=\"19\" y=\"21\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">H</text><text x=\"282\" y=\"5\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">G</text><text x=\"364\" y=\"5\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">F</text><text x=\"403\" y=\"21\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">E</text><text x=\"4\" y=\"66\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">I</text><text x=\"2\" y=\"138\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">K</text><text x=\"271\" y=\"57\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">M</text><text x=\"271\" y=\"129\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">L</text><text x=\"19\" y=\"291\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">A</text><text x=\"282\" y=\"309\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">B</text><text x=\"364\" y=\"309\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">C</text><text x=\"403\" y=\"291\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">D</text></svg><figcaption>Цвет — буква. <b style=\"color:#f0a83c\">k</b> = HI; куски левого бока <b style=\"color:#f0a83c\">HI, IK, KA = k, 2k, 4k</b> (и так же на BG). <b style=\"color:#5ba8f5\">a</b> — сторона квадрата: AB, HG, горизонтали IM и KL, высоты полосок CF и DE. <b style=\"color:#5fd38d\">b</b> = BC = FG, <b style=\"color:#f2686c\">c</b> = CD = EF.</figcaption></figure>"
}