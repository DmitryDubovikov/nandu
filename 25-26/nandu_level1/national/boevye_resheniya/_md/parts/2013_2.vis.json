='318' y2='203'/><line x1='318' y1='203' x2='318' y2='98'/><line x1='318' y1='98' x2='234' y2='35'/><line x1='234' y1='35' x2='129' y2='35'/><line x1='129' y1='35' x2='45' y2='98'/><line x1='45' y1='98' x2='45' y2='203'/><line x1='45' y1='98' x2='318' y2='98'/><line x1='45' y1='203' x2='318' y2='203'/><line x1='129' y1='35' x2='129' y2='266'/><line x1='234' y1='35' x2='234' y2='266'/></g><g fill='#93a1b1' font-size='16' text-anchor='middle' font-weight='600'><text x='123' y='25'>G</text><text x='240' y='25'>F</text><text x='29' y='102'>H</text><text x='334' y='102'>E</text><text x='29' y='211'>A</text><text x='334' y='211'>D</text><text x='123' y='288'>B</text><text x='240' y='288'>C</text></g><g fill='#5f6e7d' font-size='13' text-anchor='middle'><text x='181.5' y='72'>R3</text><text x='181.5' y='240'>R1</text><text x='87' y='160'>R4</text><text x='276' y='160'>R2</text></g><path class='dr' pathLength='100' style='--d:0.2s;--dur:2.2s' stroke='#f0a83c' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round' d='M129 266L234 266L234 35L129 35Z'/><text x='181.5' y='258' fill='#f0a83c' font-size='16' text-anchor='middle' font-weight='700' class='fi' style='--d:0.35s'>s</text><text x='242' y='128' fill='#f0a83c' font-size='16' text-anchor='start' font-weight='700' class='fi' style='--d:0.92s'>h + s + h</text><text x='181.5' y='52' fill='#f0a83c' font-size='16' text-anchor='middle' font-weight='700' class='fi' style='--d:1.48s'>s</text><text x='121' y='128' fill='#f0a83c' font-size='16' text-anchor='end' font-weight='700' class='fi' style='--d:2.05s'>h + s + h</text></svg><p class='ccap'><b>(3)</b> P(BCFG) = 224</p></div></div><figcaption>Три данных контура. У T стоят все три буквы сразу. Низ ADEH идёт сквозь R4, квадрат и R2, бок BCFG — сквозь R3, квадрат и R1: поэтому там суммы, а не одна буква.</figcaption></figure>",
