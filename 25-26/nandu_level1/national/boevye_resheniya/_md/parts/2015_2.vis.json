8.5\" width=\"18\" height=\"36.3\" fill=\"none\" fill-opacity=\"0\" stroke=\"#93a1b1\" stroke-width=\"1.4\"/><text x=\"190.0\" y=\"186.7\" fill=\"#f0a83c\" font-size=\"13\" font-weight=\"700\" text-anchor=\"end\" dominant-baseline=\"middle\" font-style=\"italic\">a</text><rect x=\"200\" y=\"204.8\" width=\"18\" height=\"13.2\" fill=\"#5ba8f5\" fill-opacity=\"0.3\" stroke=\"#93a1b1\" stroke-width=\"1.4\"/><text x=\"190.0\" y=\"211.4\" fill=\"#5ba8f5\" font-size=\"13\" font-weight=\"700\" text-anchor=\"end\" dominant-baseline=\"middle\" font-style=\"italic\">s</text><rect x=\"200\" y=\"218.0\" width=\"18\" height=\"36.3\" fill=\"none\" fill-opacity=\"0\" stroke=\"#93a1b1\" stroke-width=\"1.4\"/><text x=\"190.0\" y=\"236.2\" fill=\"#f0a83c\" font-size=\"13\" font-weight=\"700\" text-anchor=\"end\" dominant-baseline=\"middle\" font-style=\"italic\">a</text><path d=\"M176 20.0 h-6 V254.3 h6\" fill=\"none\" stroke=\"#e8eef6\" stroke-width=\"1.5\"/><text x=\"160.0\" y=\"127.2\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\" dominant-baseline=\"middle\">по деталям:</text><text x=\"160.0\" y=\"147.2\" fill=\"#e8eef6\" font-size=\"15\" font-weight=\"700\" text-anchor=\"end\" dominant-baseline=\"middle\" font-style=\"italic\">5a + 4s</text><line x1=\"150\" y1=\"218.0\" x2=\"330\" y2=\"218.0\" stroke=\"#f0a83c\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-dasharray=\"6 5\"/><text x=\"345.0\" y=\"209.0\" fill=\"#f0a83c\" font-size=\"12\" font-weight=\"400\" text-anchor=\"end\" dominant-baseline=\"middle\">уровень плиты</text><path d=\"M230 22.0 h6 V216.0 h-6\" fill=\"none\" stroke=\"#f2686c\" stroke-width=\"1.8\"/><path d=\"M230 220.0 h6 V254.3 h-6\" fill=\"none\" stroke=\"#f0a83c\" stroke-width=\"1.8\"/><text x=\"244.0\" y=\"119.0\" fill=\"#f2686c\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\" dominant-baseline=\"middle\" font-style=\"italic\">h</text><text x=\"244.0\" y=\"236.2\" fill=\"#f0a83c\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\" dominant-baseline=\"middle\" font-style=\"italic\">a</text><text x=\"270.0\" y=\"89.2\" fill=\"#e8eef6\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\" dominant-baseline=\"middle\">по уровням:</text><text x=\"270.0\" y=\"109.2\" fill=\"#e8eef6\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\" dominant-baseline=\"middle\" font-style=\"italic\">a + h</text></svg><figcaption>Колонна — одна прямая стенка от земли до верхушки. Слева её высота сложена из деталей: 5 прямоугольников высотой <b style=\"color:#f0a83c\">a</b> и 4 квадратика высотой <b style=\"color:#5ba8f5\">s</b>. Справа — из уровней: плита <b style=\"color:#f0a83c\">a</b> и стенка над ней <b style=\"color:#f2686c\">h</b>. Это одна длина, поэтому 5a + 4s = a + h.</figcaption></figure>"
