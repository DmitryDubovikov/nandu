\" y1=\"38.0\" x2=\"165.0\" y2=\"290.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-dasharray=\"6 6\"/><line x1=\"543.0\" y1=\"290.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--muted)\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><line x1=\"165.0\" y1=\"38.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--gold)\" stroke-width=\"4.5\" stroke-linecap=\"round\"/><g class=\"sl\" style=\"--to:translate(0,252.0px);--d:.6s\"><line x1=\"165.0\" y1=\"38.0\" x2=\"543.0\" y2=\"38.0\" stroke=\"var(--gold)\" stroke-width=\"5.5\" stroke-linecap=\"round\"/></g><circle cx=\"165.0\" cy=\"290.0\" r=\"4.5\" fill=\"var(--gold)\"/><text x=\"165.0\" y=\"316.0\" fill=\"var(--gold)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">M</text><circle cx=\"60.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"48.0\" y=\"526.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">A</text><circle cx=\"270.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"270.0\" y=\"528.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">B</text><circle cx=\"543.0\" cy=\"500.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"555.0\" y=\"526.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">C</text><circle cx=\"60.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"42.0\" y=\"296.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">G</text><circle cx=\"270.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"284.0\" y=\"280.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">H</text><circle cx=\"543.0\" cy=\"290.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"557.0\" y=\"280.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">I</text><circle cx=\"543.0\" cy=\"38.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"557.0\" y=\"28.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">E</text><circle cx=\"165.0\" cy=\"38.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"165.0\" y=\"24.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">F</text><circle cx=\"643.7\" cy=\"269.0\" r=\"4.5\" fill=\"#e8eef6\"/><text x=\"659.7\" y=\"273.0\" fill=\"#e8eef6\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">D</text><text x=\"112.5\" y=\"280.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">s : 2</text><text x=\"217.5\" y=\"280.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">s : 2</text><text x=\"406.5\" y=\"318.0\" fill=\"var(--muted)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"96.5\" y=\"164.0\" fill=\"var(--blue)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"233.5\" y=\"164.0\" fill=\"var(--blue)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">t</text><text x=\"354.0\" y=\"26.0\" fill=\"var(--gold)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"600\">FE = s : 2 + t</text></svg><figcaption>Синие стороны крыши равны, поэтому F стоит ровно над серединой M отрезка GH. FM и EI — вертикали, FE параллельна GI, так что FMIE — прямоугольник: золотой потолок FE опускается и ложится точно на пол MI — половину стороны квадрата и ещё HI.</figcaption></figure>",
 "Объясни, как ты их считал.": "<figure class=\"st\"><svg viewBox=\"0 0 600 140\" width=\"100%\" style=\"max-width:640px\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><text x=\"52.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">1</text><rect x=\"30\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"96.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">2</text><rect x=\"74\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"140.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">3</text><rect x=\"118\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"184.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">4</text><rect x=\"162\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"228.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">5</text><rect x=\"206\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"272.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">6</text><rect x=\"250\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"316.0\" y=\"22\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">7</text><rect x=\"294\" y=\"30\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"184.0\" y=\"96\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"middle\" font-weight=\"400\">доска: 7 клеток в ряд</text><circle cx=\"390\" cy=\"22\" r=\"11\" fill=\"var(--blue)\" fill-opacity=\".55\" stroke=\"var(--blue)\" stroke-width=\"1.5\"/><text x=\"478\" y=\"27\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">1 синяя (a)</text><circle cx=\"390\" cy=\"52\" r=\"11\" fill=\"var(--red)\" fill-opacity=\".55\" stroke=\"var(--red)\" stroke-width=\"1.5\"/><text x=\"478\" y=\"57\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">1 красная (r)</text><circle cx=\"390\" cy=\"82\" r=\"11\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"var(--green)\" stroke-width=\"1.5\"/><circle cx=\"418\" cy=\"82\" r=\"11\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"var(--green)\" stroke-width=\"1.5\"/><text x=\"478\" y=\"87\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">2 зелёные (v)</text><circle cx=\"390\" cy=\"112\" r=\"11\" fill=\"var(--ink)\" fill-opacity=\".85\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><circle cx=\"418\" cy=\"112\" r=\"11\" fill=\"var(--ink)\" fill-opacity=\".85\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><circle cx=\"446\" cy=\"112\" r=\"11\" fill=\"var(--ink)\" fill-opacity=\".85\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"478\" y=\"117\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">3 белые (b)</text></svg><figcaption>Пустая доска из условия и семь фишек. Фишки одного цвета одинаковые: доска — это только цвета в клетках.</figcaption></figure>",
 "пары из них не собрать": "<figure class=\"st\"><svg viewBox=\"0 0 600 140\" width=\"100%\" style=\"max-width:640px\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><text x=\"52.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">1</text><rect x=\"30\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--red)\" fill-opacity=\".12\" stroke=\"var(--red)\" stroke-width=\"1.5\"/><path d=\"M40 44 L64 68 M64 44 L40 68\" stroke=\"var(--red)\" stroke-width=\"2\"/><text x=\"96.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">2</text><rect x=\"74\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"140.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">3</text><rect x=\"118\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--gold)\" fill-opacity=\".18\" stroke=\"var(--gold)\" stroke-width=\"2.5\"/><text x=\"140.0\" y=\"62.0\" fill=\"var(--gold)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"700\">?</text><text x=\"184.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">4</text><rect x=\"162\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"228.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">5</text><rect x=\"206\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--gold)\" fill-opacity=\".18\" stroke=\"var(--gold)\" stroke-width=\"2.5\"/><text x=\"228.0\" y=\"62.0\" fill=\"var(--gold)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"700\">?</text><text x=\"272.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">6</text><rect x=\"250\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--bg2)\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"316.0\" y=\"24\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">7</text><rect x=\"294\" y=\"34\" width=\"44\" height=\"44\" fill=\"var(--red)\" fill-opacity=\".12\" stroke=\"var(--red)\" stroke-width=\"1.5\"/><path d=\"M304 44 L328 68 M328 44 L304 68\" stroke=\"var(--red)\" stroke-width=\"2\"/><circle cx=\"184.0\" cy=\"56.0\" r=\"13\" fill=\"var(--blue)\" fill-opacity=\".55\" stroke=\"var(--blue)\" stroke-width=\"1.5\"/><text x=\"52.0\" y=\"98\" fill=\"var(--red)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">нельзя</text><text x=\"316.0\" y=\"98\" fill=\"var(--red)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">нельзя</text><text x=\"140.0\" y=\"98\" fill=\"var(--gold)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">сосед</text><text x=\"228.0\" y=\"98\" fill=\"var(--gold)\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">сосед</text><text x=\"380\" y=\"30\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">плохо, если соседи:</text><circle cx=\"392\" cy=\"58\" r=\"10\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"var(--green)\" stroke-width=\"1.5\"/><circle cx=\"420\" cy=\"58\" r=\"10\" fill=\"var(--blue)\" fill-opacity=\".55\" stroke=\"var(--blue)\" stroke-width=\"1.5\"/><circle cx=\"448\" cy=\"58\" r=\"10\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"var(--green)\" stroke-width=\"1.5\"/><text x=\"468\" y=\"63\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">оба зелёные</text><circle cx=\"392\" cy=\"90\" r=\"10\" fill=\"var(--ink)\" fill-opacity=\".85\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><circle cx=\"420\" cy=\"90\" r=\"10\" fill=\"var(--blue)\" fill-opacity=\".55\" stroke=\"var(--blue)\" stroke-width=\"1.5\"/><circle cx=\"448\" cy=\"90\" r=\"10\" fill=\"var(--ink)\" fill-opacity=\".85\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"468\" y=\"95\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">оба белые</text><text x=\"380\" y=\"126\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"start\" font-weight=\"400\">других одноцветных пар нет</text></svg><figcaption>Синяя не с краю — у неё ровно два соседа. Красная и синяя по одной, поэтому одноцветная пара соседей бывает только зелёная или белая.</figcaption></figure>",
 "Без машины — остальные 9 кусков": "<figure class=\"st\"><svg viewBox=\"0 0 560 176\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><path d=\"M42 30 V24 H134 V30\" fill=\"none\" stroke=\"#cfdae6\" stroke-width=\"1.3\"/><text x=\"88.0\" y=\"18\" fill=\"#cfdae6\" font-size=\"12\" text-anchor=\"middle\">электро: 4 куска</text><path d=\"M114 58 V52 H302 V58\" fill=\"none\" stroke=\"var(--green)\" stroke-width=\"1.3\"/><text x=\"208.0\" y=\"46\" fill=\"var(--green)\" font-size=\"12\" text-anchor=\"middle\">бензин: 8 кусков</text><rect x=\"40\" y=\"62\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"64\" y=\"62\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"88\" y=\"62\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"112\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--gold)\" fill-opacity=\".75\" stroke=\"#2c394c\"/><rect x=\"136\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"160\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"184\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"208\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"232\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"256\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"280\" y=\"62\" width=\"24\" height=\"28\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"#2c394c\"/><rect x=\"304\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"328\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"352\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"376\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"400\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"424\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"448\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"472\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"496\" y=\"62\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><text x=\"76.0\" y=\"108\" fill=\"#cfdae6\" font-size=\"11\" text-anchor=\"middle\">только</text><text x=\"76.0\" y=\"122\" fill=\"#cfdae6\" font-size=\"11\" text-anchor=\"middle\">электро 3</text><text x=\"124.0\" y=\"108\" fill=\"var(--gold)\" font-size=\"11\" text-anchor=\"middle\">оба</text><text x=\"124.0\" y=\"122\" fill=\"var(--gold)\" font-size=\"11\" text-anchor=\"middle\">1</text><text x=\"208\" y=\"108\" fill=\"#cfdae6\" font-size=\"11\" text-anchor=\"middle\">только бензин</text><text x=\"208\" y=\"122\" fill=\"#cfdae6\" font-size=\"11\" text-anchor=\"middle\">7</text><path d=\"M306 92 V98 H518 V92\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"1.3\"/><text x=\"412.0\" y=\"114\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\">ни одной: 9 кусков</text><text x=\"412.0\" y=\"130\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"middle\">9 · 1450 = 13 050</text><text x=\"280\" y=\"160\" fill=\"#cfdae6\" font-size=\"12\" text-anchor=\"middle\">всего 20 кусков по 1450 = 29 000 жителей</text></svg><figcaption>Электро и бензин перекрываются ровно на один кусок — «оба». Вместе они занимают 4 + 8 − 1 = 11 кусков, остальные 9 — жители без машины.</figcaption></figure>",
 "это двадцатая часть всех жителей": "<figure class=\"st\"><svg viewBox=\"0 0 560 160\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><path d=\"M42 46 V40 H134 V46\" fill=\"none\" stroke=\"#cfdae6\" stroke-width=\"1.3\"/><text x=\"88.0\" y=\"34\" fill=\"#cfdae6\" font-size=\"12\" text-anchor=\"middle\">электромобиль: 1/5 жителей</text><rect x=\"40\" y=\"50\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"64\" y=\"50\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"88\" y=\"50\" width=\"24\" height=\"28\" fill=\"#3d5a82\" fill-opacity=\".8\" stroke=\"#2c394c\"/><rect x=\"112\" y=\"50\" width=\"24\" height=\"28\" fill=\"var(--gold)\" fill-opacity=\".75\" stroke=\"#2c394c\"/><rect x=\"136\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"160\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"184\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"208\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"232\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"256\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"280\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"304\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"328\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"352\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"376\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"400\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"424\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"448\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"472\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><rect x=\"496\" y=\"50\" width=\"24\" height=\"28\" fill=\"#2c394c\" fill-opacity=\".35\" stroke=\"#2c394c\"/><path d=\"M114 80 V86 H134 V80\" fill=\"none\" stroke=\"var(--gold)\" stroke-width=\"1.3\"/><text x=\"124.0\" y=\"102\" fill=\"var(--gold)\" font-size=\"12\" text-anchor=\"middle\">оба = 1450: 1/4 от них</text><path d=\"M42 122 V128 H518 V122\" fill=\"none\" stroke=\"#cfdae6\" stroke-width=\"1.3\"/><text x=\"280.0\" y=\"144\" fill=\"#cfdae6\" font-size=\"12\" text-anchor=\"middle\">все жители h — 20 равных кусков</text></svg><figcaption>Пятую часть жителей режем ещё на четыре куска — и каждый такой кусок оказывается двадцатой частью всех. Один из них — «оба вида», 1450 человек.</figcaption></figure>",
 "Чему равен периметр R?": "<figure class=\"st\"><svg viewBox=\"0 0 420 242\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><rect x=\"110\" y=\"40\" width=\"264.0\" height=\"168.0\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\"/><line x1=\"110.0\" y1=\"107.2\" x2=\"374.0\" y2=\"107.2\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"225.2\" y1=\"40.0\" x2=\"225.2\" y2=\"107.2\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"162.8\" y1=\"107.2\" x2=\"162.8\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"215.6\" y1=\"107.2\" x2=\"215.6\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"268.4\" y1=\"107.2\" x2=\"268.4\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"321.2\" y1=\"107.2\" x2=\"321.2\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"31.2\" y1=\"124.0\" x2=\"110.0\" y2=\"40.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"31.2\" y1=\"124.0\" x2=\"110.0\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"110.0\" cy=\"40.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"225.2\" cy=\"40.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"374.0\" cy=\"40.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"110.0\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"374.0\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"31.2\" cy=\"124.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"110.0\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"374.0\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"162.8\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"215.6\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"268.4\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"321.2\" cy=\"107.2\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"162.8\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"215.6\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"268.4\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><circle cx=\"321.2\" cy=\"208.0\" r=\"3.2\" fill=\"var(--ink)\"/><text x=\"167.6\" y=\"80.6\" fill=\"var(--ink)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">A</text><text x=\"299.6\" y=\"80.6\" fill=\"var(--ink)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">B</text><text x=\"80.0\" y=\"130.0\" fill=\"var(--ink)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">T</text><text x=\"136.4\" y=\"164.6\" fill=\"var(--ink)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">R</text></svg><figcaption>Рисунок условия. Сверху — A и B (вместе — прямоугольник), снизу — пять равных R; слева к фигуре целиком приклеен равнобедренный треугольник T остриём влево.</figcaption></figure>",
 "P(фигуры) − P(T) = 2·(x + y)": "<figure class=\"fx\"><svg viewBox=\"0 0 420 242\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><rect x=\"110\" y=\"40\" width=\"264.0\" height=\"168.0\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\"/><line x1=\"110.0\" y1=\"107.2\" x2=\"374.0\" y2=\"107.2\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"225.2\" y1=\"40.0\" x2=\"225.2\" y2=\"107.2\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"162.8\" y1=\"107.2\" x2=\"162.8\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"215.6\" y1=\"107.2\" x2=\"215.6\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"268.4\" y1=\"107.2\" x2=\"268.4\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"321.2\" y1=\"107.2\" x2=\"321.2\" y2=\"208.0\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-linecap=\"round\"/><line x1=\"31.2\" y1=\"124.0\" x2=\"110.0\" y2=\"40.0\" stroke=\"var(--gold)\" stroke-width=\"4\" stroke-linecap=\"round\"/><line x1=\"31.2\" y1=\"124.0\" x2=\"110.0\" y2=\"208.0\" stroke=\"var(--gold)\" stroke-width=\"4\" stroke-linecap=\"round\"/><line x1=\"110.0\" y1=\"40.0\" x2=\"110.0\" y2=\"208.0\" stroke=\"var(--blue)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-dasharray=\"7 6\"/><g class=\"sl\" style=\"--to:translate(264.0px,0);--d:.6s\"><line x1=\"110.0\" y1=\"40.0\" x2=\"110.0\" y2=\"208.0\" stroke=\"var(--blue)\" stroke-width=\"5\" stroke-linecap=\"round\"/></g><text x=\"54.6\" y=\"86.0\" fill=\"var(--gold)\" font-size=\"16\" text-anchor=\"middle\" font-weight=\"600\">x</text><text x=\"54.6\" y=\"180.0\" fill=\"var(--gold)\" font-size=\"16\" text-anchor=\"middle\" font-weight=\"600\">x</text><text x=\"128.0\" y=\"158.0\" fill=\"var(--blue)\" font-size=\"15\" text-anchor=\"middle\" font-weight=\"600\">5k</text><text x=\"394.0\" y=\"129.0\" fill=\"var(--blue)\" font-size=\"15\" text-anchor=\"middle\" font-weight=\"600\">5k</text><text x=\"167.6\" y=\"80.6\" fill=\"var(--muted)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">A</text><text x=\"299.6\" y=\"80.6\" fill=\"var(--muted)\" font-size=\"18\" text-anchor=\"middle\" font-weight=\"600\">B</text></svg><figcaption>Золотые боковые стороны T лежат на контуре фигуры — они входят в оба периметра. Синее основание (5k) спрятано внутри фигуры, но правая стена — ровно такой же длины: основание «переезжает» на неё. Поэтому хвост 5k + 2x стоит в обоих периметрах и при вычитании уходит.</figcaption></figure>",
 "Объясни, как ты их считал": "<figure class=\"st\"><svg viewBox=\"0 0 560 196\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><rect x=\"150\" y=\"40\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"178.0\" y=\"74.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">a₁</text><rect x=\"206\" y=\"40\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"234.0\" y=\"74.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">a₂</text><rect x=\"262\" y=\"40\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"290.0\" y=\"74.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">a₃</text><rect x=\"318\" y=\"40\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"346.0\" y=\"74.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">a₄</text><rect x=\"150\" y=\"96\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"178.0\" y=\"130.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">b₁</text><rect x=\"206\" y=\"96\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"234.0\" y=\"130.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">b₂</text><rect x=\"262\" y=\"96\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"290.0\" y=\"130.0\" fill=\"var(--ink)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">b₃</text><rect x=\"318\" y=\"96\" width=\"56\" height=\"56\" fill=\"#161d29\" stroke=\"var(--muted)\" stroke-width=\"1.5\"/><text x=\"346.0\" y=\"130.0\" fill=\"var(--ink)\" font-size=\"1