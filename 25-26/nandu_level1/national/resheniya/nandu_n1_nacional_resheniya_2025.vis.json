 text-anchor=\"middle\" font-weight=\"400\">15</text><rect x=\"334\" y=\"116\" width=\"32\" height=\"32\" fill=\"#3a2f18\" stroke=\"var(--gold)\"/><text x=\"350.0\" y=\"138.0\" fill=\"var(--gold)\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">0</text><rect x=\"334\" y=\"84\" width=\"32\" height=\"32\" fill=\"#16263a\" stroke=\"#2c394c\"/><text x=\"350.0\" y=\"106.0\" fill=\"#e8eef6\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">2</text><rect x=\"334\" y=\"52\" width=\"32\" height=\"32\" fill=\"#16263a\" stroke=\"#2c394c\"/><text x=\"350.0\" y=\"74.0\" fill=\"#e8eef6\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">5</text><rect x=\"334\" y=\"20\" width=\"32\" height=\"32\" fill=\"#16263a\" stroke=\"#2c394c\"/><text x=\"350.0\" y=\"42.0\" fill=\"#e8eef6\" font-size=\"17\" text-anchor=\"middle\" font-weight=\"400\">8</text><text x=\"350.0\" y=\"168\" fill=\"var(--green)\" font-size=\"13\" text-anchor=\"middle\" font-weight=\"400\">15</text><text x=\"228\" y=\"86\" fill=\"var(--gold)\" font-size=\"26\" text-anchor=\"middle\" font-weight=\"400\">⇄</text><text x=\"228\" y=\"116\" fill=\"var(--gold)\" font-size=\"16\" text-anchor=\"middle\" font-weight=\"600\">×2</text><text x=\"78\" y=\"180\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"start\" font-weight=\"400\">ноль во втором столбце</text><text x=\"318\" y=\"180\" fill=\"var(--muted)\" font-size=\"12\" text-anchor=\"start\" font-weight=\"400\">ноль в третьем</text></svg><figcaption>Набор цифр один и тот же, а доски разные: длинные столбцы стоят на разных местах доски, и поменять их местами — значит получить вторую раскладку.</figcaption></figure>",
 "max(коробок) = 14, значит N(пакетов) = 5 — стоп": "<figure class=\"st\"><svg viewBox=\"0 0 600 236\" width=\"100%\"  xmlns=\"http://www.w3.org/2000/svg\" font-family=\"ui-sans-serif,-apple-system,sans-serif\"><text x=\"20\" y=\"22\" fill=\"#cfdae6\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">пакет — 6 штук за 150 песо</text><rect x=\"20\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><rect x=\"35\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><rect x=\"50\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><rect x=\"65\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><rect x=\"80\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><rect x=\"95\" y=\"30\" width=\"12\" height=\"12\" fill=\"#16263a\" stroke=\"var(--blue)\"/><text x=\"126\" y=\"41\" fill=\"#cfdae6\" font-size=\"14\" text-anchor=\"start\" font-weight=\"400\">150 : 6 = 25 песо за штуку</text><text x=\"20\" y=\"74\" fill=\"#cfdae6\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">коробка — 25 штук за 600 песо</text><rect x=\"20\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"34\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"48\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"62\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"76\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"90\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"104\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"118\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"132\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"146\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"160\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"174\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"188\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"202\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"216\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"230\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"244\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"258\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"272\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"286\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"300\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"314\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"328\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"342\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><rect x=\"356\" y=\"82\" width=\"12\" height=\"12\" fill=\"#12281c\" stroke=\"var(--green)\"/><text x=\"20\" y=\"116\" fill=\"var(--green)\" font-size=\"14\" text-anchor=\"start\" font-weight=\"400\">600 : 25 = 24 песо за штуку — дешевле</text><text x=\"20\" y=\"152\" fill=\"var(--muted)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">нужно ровно 380 → коробок берём столько, сколько влезет</text><text x=\"66\" y=\"176\" fill=\"#cfdae6\" font-size=\"13\" text-anchor=\"end\" font-weight=\"400\">К = 15</text><rect x=\"76\" y=\"160\" width=\"296\" height=\"20\" fill=\"var(--blue)\" fill-opacity=\".45\" stroke=\"var(--blue)\"/><text x=\"224\" y=\"175\" fill=\"#dceaff\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">25 · 15 = 375</text><rect x=\"372\" y=\"160\" width=\"4\" height=\"20\" fill=\"var(--red)\"/><text x=\"390\" y=\"175\" fill=\"var(--red)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">остаток 5 — на 6 не делится</text><text x=\"66\" y=\"216\" fill=\"#cfdae6\" font-size=\"13\" text-anchor=\"end\" font-weight=\"400\">К = 14</text><rect x=\"76\" y=\"200\" width=\"276\" height=\"20\" fill=\"var(--blue)\" fill-opacity=\".45\" stroke=\"var(--blue)\"/><text x=\"214\" y=\"215\" fill=\"#dceaff\" font-size=\"12\" text-anchor=\"middle\" font-weight=\"400\">25 · 14 = 350</text><rect x=\"352\" y=\"200\" width=\"24\" height=\"20\" fill=\"var(--green)\" fill-opacity=\".55\" stroke=\"var(--green)\"/><text x=\"390\" y=\"215\" fill=\"var(--green)\" font-size=\"13\" text-anchor=\"start\" font-weight=\"400\">остаток 30 = 6 · 5 — пять пакетов</text></svg><figcaption>Штук всё равно ровно 380, поэтому дороже или дешевле выходит только то, по какой цене куплена каждая штука: первое же К, у которого остаток делится на 6, и есть ответ.</figcaption></figure>"
